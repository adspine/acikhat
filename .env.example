# HTTP portu
PORT=8787

# ElevenLabs webhook araçlarının gönderdiği "Authorization: Bearer <...>" değeri.
# ElevenLabs'te workspace secret olarak saklanmalı.
TOOL_SECRET=degistir-uzun-rastgele-deger

# slot_id imzalamak için anahtar (LLM'in saat uydurmasını engeller)
SLOT_SIGNING_KEY=degistir-baska-uzun-rastgele-deger

# ElevenLabs post-call webhook HMAC secret'ı (webhook oluşturulurken verilir)
ELEVENLABS_WEBHOOK_SECRET=

# Backend'in dışarıdan erişilen adresi (agent config üretirken kullanılır)
PUBLIC_BASE_URL=https://ornek.example.com

# SQLite dosyası
DB_PATH=data/app.db

# SMS sağlayıcısı: console | netgsm (netgsm adaptörü henüz yazılmadı)
SMS_PROVIDER=console

# ElevenLabs API anahtarı (yalnızca .env içine yazılır)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_PRONUNCIATION_DICT_ID=
ELEVENLABS_PRONUNCIATION_DICT_VERSION=

# Netgsm webportal > Ses Hizmeti > Ayarlar > Sip Bilgileri
NETGSM_SIP_USERNAME=
NETGSM_SIP_PASSWORD=

# Google Takvim servis hesabı anahtarı (docs/google-takvim-kurulumu.md)
GOOGLE_SERVICE_ACCOUNT_FILE=

# Firebase proje kimliği (üye girişi; boşsa acikhat-ai). Gizli değil: yalnızca kimlik belgesinin kime ait olduğunu denetler.
FIREBASE_PROJECT_ID=acikhat-ai

# Gerçek ödeme bağlanana kadar: 1 ise üyelik akışındaki "Ödemeyi tamamla" paketi ödenmiş sayar (ücret alınmaz).
# Boşsa geliştirmede açık, canlıda (NODE_ENV=production) kapalıdır.
PAYMENT_TEST_MODE=

# Yönetici hesapları: Firebase ile (Google veya e-posta) giren ve e-postası doğrulanmış bu adresler yönetici olur. Virgülle ayrılır.
ADMIN_EMAILS=

# Sistem e-postaları (Resend: https://resend.com). Anahtar boşsa e-posta gönderilmez, yalnızca günlüğe yazılır.
# Gönderen alan adı (acikhat.ai) Resend'de doğrulanmış olmalıdır. E-postalardaki bağlantılar PUBLIC_BASE_URL ile kurulur.
RESEND_API_KEY=
MAIL_FROM=Açık Hat <bildirim@acikhat.ai>
