{
  "name": "sesli-resepsiyonist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "agent:build": "node --env-file-if-exists=.env scripts/build-agent.ts",
    "agent:push": "node --env-file=.env scripts/push-agent.ts",
    "phone:connect": "node --env-file=.env scripts/connect-phone.ts",
    "onboarding": "node --env-file=.env scripts/onboarding-to-tenant.ts",
    "calendar:check": "node --env-file=.env scripts/check-calendar.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "hono": "4.13.13",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
