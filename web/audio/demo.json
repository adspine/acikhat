{
  "duration": 37.59,
  "lines": [
    {
      "who": "agent",
      "text": "Lavanta Spa, merhaba. Ben yapay zekâ asistanı Defne. Size nasıl yardımcı olabilirim?",
      "start": 0.4,
      "end": 6.4
    },
    {
      "who": "caller",
      "text": "Merhaba, yarın akşam için masaj randevusu almak istiyorum.",
      "start": 6.95,
      "end": 10.71
    },
    {
      "who": "agent",
      "text": "Yarın akşam saat 18 ya da 19 uygun görünüyor. Hangisini tercih edersiniz?",
      "start": 11.26,
      "end": 16.94
    },
    {
      "who": "caller",
      "text": "18 olsun.",
      "start": 17.49,
      "end": 18.61
    },
    {
      "who": "agent",
      "text": "Adınızı ve soyadınızı alabilir miyim?",
      "start": 19.16,
      "end": 21.4
    },
    {
      "who": "caller",
      "text": "Kerem Aydın.",
      "start": 21.95,
      "end": 22.99
    },
    {
      "who": "agent",
      "text": "Yarın, saat 18, klasik masaj, Kerem Aydın adına. Onay mesajı numaranıza gelecek. Onaylıyor musunuz?",
      "start": 23.54,
      "end": 30.82
    },
    {
      "who": "caller",
      "text": "Evet, onaylıyorum.",
      "start": 31.37,
      "end": 32.89
    },
    {
      "who": "agent",
      "text": "Randevunuz alındı. Görüşmek üzere, iyi günler dilerim.",
      "start": 33.44,
      "end": 37.04
    }
  ]
